# Copy to .env and fill in. Everything here is optional.

# Intraday Brent/WTI quotes from https://www.oilpriceapi.com (free tier available).
# Without it the dashboard uses FRED's keyless daily history only.
OILPRICEAPI_KEY=

# Set to 0 to stop `npm run dev` from collecting on startup and hourly.
# COLLECT_ON_DEV=0
